# Server-only OpenRouter credential. Never use a NEXT_PUBLIC_ prefix.
OPENROUTER_API_KEY=

# Optional model overrides. The application and corpus scripts provide defaults.
OPENROUTER_MODEL=
OPENROUTER_EMBEDDING_MODEL=
OPENROUTER_DOCUMENT_INPUT_TYPE=
EMBEDDING_BATCH_SIZE=64

# Comma-separated access lists used by the authenticated application.
AUTH_ALLOWED_EMAILS=
AUTH_ALLOWED_DOMAINS=
AUTH_LOG_VIEWER_EMAILS=
